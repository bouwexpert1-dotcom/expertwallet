{
  "name": "PendingDeposit",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "spinatlas_transaction_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "applied"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "pending"
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "applied_user_id": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "email",
    "amount",
    "spinatlas_transaction_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}